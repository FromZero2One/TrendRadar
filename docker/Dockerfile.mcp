FROM python:3.10-slim

# 设置工作目录为 /app。之后的 COPY、RUN 等命令将在该目录下执行。
WORKDIR /app

# 安装依赖
COPY requirements.txt .
# 推荐 pip install --no-cache-dir --upgrade pip，但这不是必须的
RUN pip install --no-cache-dir --upgrade pip
# --no-cache-dir 避免保留 pip 下载缓存，减小镜像体积
RUN pip install --no-cache-dir -r requirements.txt

# 复制 MCP 服务器代码
COPY mcp_server/ ./mcp_server/
# 复制 trendradar 模块（MCP 服务需要读取 SQLite 数据）
COPY trendradar/ ./trendradar/

# 创建必要目录
RUN mkdir -p /app/config /app/output

ENV PYTHONUNBUFFERED=1 \ # 关闭 Python 缓冲，实时输出日志
    CONFIG_PATH=/app/config/config.yaml \
    FREQUENCY_WORDS_PATH=/app/config/frequency_words.txt

# MCP HTTP 服务端口
EXPOSE 3333

# 启动 MCP 服务器（HTTP 模式）
CMD ["python", "-m", "mcp_server.server", "--transport", "http", "--host", "0.0.0.0", "--port", "3333"]
